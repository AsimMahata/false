# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection
# Replace with your actual MongoDB URI (e.g., from MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/statement_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/statement_tracker?retryWrites=true&w=majority
DB_NAME=statement_tracker
